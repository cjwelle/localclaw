#!/usr/bin/env bash
# Friendly command entry point, modeled after OpenClaw's install/update/doctor
# ergonomics while keeping this repository's explicit safety prompts.
set -uo pipefail
ROOT="$(cd "$(dirname "$0")" && pwd)"
case "${1:-}" in
  install) shift; exec "${ROOT}/scripts/install" "$@" ;;
  doctor) shift; exec "${ROOT}/scripts/doctor" "$@" ;;
  update) shift; exec "${ROOT}/scripts/update" "$@" ;;
  backup)
    shift
    case "${1:-}" in
      verify) shift; exec "${ROOT}/scripts/credentials" backup-verify "$@" ;;
      *) exec "${ROOT}/scripts/backup" "$@" ;;
    esac ;;
  credentials) shift; exec "${ROOT}/scripts/credentials" "$@" ;;
  bootstrap|vault-start|vault-bootstrap|work-session|restore|uninstall)
    command="${ROOT}/scripts/${1}"; shift; exec "${command}" "$@" ;;
  ''|-h|--help)
    cat <<EOF
Usage: osls <command> [options]

Commands: install, bootstrap, doctor, update, credentials, backup verify,
          restore, vault-start, vault-bootstrap, work-session, uninstall.
Run 'osls credentials --help' for password-manager setup.
EOF
    [ "${1:-}" = '' ] && exit 2 || exit 0 ;;
  *) printf 'Unknown osls command: %s\n' "$1" >&2; exit 2 ;;
esac
