#!/usr/bin/env bash
# Friendly command entry point for LocalClaw.
set -uo pipefail
ROOT="$(cd "$(dirname "$0")" && pwd)"
usage() {
  cat <<EOF
Usage: localclaw <command> [options]

Commands: setup, install, bootstrap, doctor, update, credentials, backup verify,
          restore, vault-start, vault-stop, vault-bootstrap, work-session,
          uninstall.

Guided setup:
  localclaw setup                 Install, update-check, bootstrap, doctor, test, E2E
                                  Prompts for Vault / password-manager mode if omitted
  localclaw setup --secret-backend vault|password-manager
                                  Select the session secret backend
  localclaw setup --password-manager bitwarden|1password|lastpass
                                  Select the password-manager CLI
  localclaw setup --apply-update  Also apply the latest canonical release tag
  localclaw setup --skip-tests    Skip the regression suite
  localclaw setup --skip-e2e      Skip the end-to-end lifecycle test

Installer:
  localclaw install --secret-backend vault|password-manager
                                  Select the session secret backend
  localclaw install --password-manager none|bitwarden|1password|lastpass
                                  Select the password-manager CLI to install

Run 'localclaw credentials --help' for password-manager setup.
EOF
}

write_setup_config_key() {
  local key="$1" value="$2" file tmp
  file="${XDG_CONFIG_HOME:-${HOME}/.config}/localclaw/stack.conf"
  [ -r "${file}" ] || { printf 'Missing setup config: %s\n' "${file}" >&2; return 1; }
  tmp="$(mktemp "${file}.tmp.XXXXXX")" || return 1
  awk -v key="${key}" -v value="${value}" '
    BEGIN { done=0 }
    $0 ~ "^[[:space:]]*" key "=" {
      if (!done) { print key "=" value; done=1 }
      next
    }
    { print }
    END { if (!done) print key "=" value }
  ' "${file}" >"${tmp}" || { rm -f "${tmp}"; return 1; }
  chmod 600 "${tmp}" && mv "${tmp}" "${file}"
}

prompt_setup_mode() {
  while :; do
    printf '\n== LocalClaw setup mode ==\n' >&2
    printf '  1) Vault only\n' >&2
    printf '  2) Vault + password manager\n' >&2
    printf '  3) Password-manager only\n' >&2
    printf 'Select 1, 2, or 3 [1]: ' >&2
    IFS= read -r choice || choice=""
    case "${choice}" in
      ''|1|vault|vault-only)
        secret_backend="vault"
        password_manager="none"
        setup_mode="vault-only"
        return 0
        ;;
      2|'vault + password manager'|'vault+password-manager'|'vault-password-manager'|'vault-password-manager-only')
        secret_backend="vault"
        password_manager=""
        setup_mode="vault+pm"
        return 0
        ;;
      3|'password-manager'|'password-manager-only'|pm)
        secret_backend="password-manager"
        password_manager=""
        setup_mode="password-manager-only"
        return 0
        ;;
      *)
        printf 'Please choose 1, 2, or 3.\n' >&2
        ;;
    esac
  done
}

prompt_password_manager() {
  while :; do
    printf '\nWhich password manager should LocalClaw use?\n' >&2
    printf '  1) Bitwarden\n' >&2
    printf '  2) 1Password\n' >&2
    printf '  3) LastPass\n' >&2
    printf 'Select 1, 2, or 3 [1]: ' >&2
    IFS= read -r choice || choice=""
    case "${choice}" in
      ''|1|bitwarden) password_manager="bitwarden"; return 0 ;;
      2|1password) password_manager="1password"; return 0 ;;
      3|lastpass) password_manager="lastpass"; return 0 ;;
      *)
        printf 'Please choose 1, 2, or 3.\n' >&2
        ;;
    esac
  done
}

setup() {
  local apply_update=0 skip_tests=0 skip_e2e=0 secret_backend="" password_manager="" setup_mode=""
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --apply-update) apply_update=1 ;;
      --skip-tests) skip_tests=1 ;;
      --skip-e2e) skip_e2e=1 ;;
      --secret-backend) [ "$#" -ge 2 ] || { printf '%s\n' '--secret-backend requires a value' >&2; return 2; }; secret_backend="$2"; shift ;;
      --password-manager) [ "$#" -ge 2 ] || { printf '%s\n' '--password-manager requires a value' >&2; return 2; }; password_manager="$2"; shift ;;
      -h|--help) usage; return 0 ;;
      *) printf 'Unknown setup option: %s\n' "$1" >&2; return 2 ;;
    esac
    shift
  done

  if [ -z "${secret_backend}" ]; then
    if [ -n "${password_manager}" ] && [ "${password_manager}" != "none" ]; then
      secret_backend="vault"
      setup_mode="vault+pm"
    elif [ -t 0 ]; then
      prompt_setup_mode
    else
      secret_backend="vault"
      password_manager="none"
      setup_mode="vault-only"
    fi
  fi
  case "${secret_backend}" in
    vault|password-manager) : ;;
    *) printf 'Unknown setup secret backend: %s\n' "${secret_backend}" >&2; return 2 ;;
  esac
  if [ "${secret_backend}" = "vault" ] && [ "${password_manager}" = "" ]; then
    if [ "${setup_mode}" = "vault+pm" ]; then
      if [ -t 0 ]; then
        prompt_password_manager
      else
        printf '%s\n' 'Vault + password manager requires --password-manager bitwarden|1password|lastpass.' >&2
        return 2
      fi
    else
      password_manager="none"
      setup_mode="vault-only"
    fi
  fi
  if [ "${secret_backend}" = "password-manager" ] && [ "${password_manager}" = "" ]; then
    if [ -t 0 ]; then
      prompt_password_manager
    else
      printf '%s\n' 'Password-manager mode requires --password-manager bitwarden|1password|lastpass.' >&2
      return 2
    fi
  fi
  if [ "${secret_backend}" = "vault" ] && [ "${password_manager}" = "" ]; then
    password_manager="none"
  fi
  case "${password_manager}" in
    ""|none|bitwarden|1password|lastpass) : ;;
    *) printf 'Unknown password manager: %s\n' "${password_manager}" >&2; return 2 ;;
  esac

  printf '%s\n' '== LocalClaw guided setup ==' >&2
  printf '%s\n' '[1/6] Checking and installing prerequisites (permission required)...' >&2
  "${ROOT}/scripts/install" --apply --secret-backend "${secret_backend}" --password-manager "${password_manager}" || return $?

  printf '%s\n' '[2/6] Checking for a canonical release update...' >&2
  "${ROOT}/scripts/update" --check || return $?
  if [ "${apply_update}" -eq 1 ]; then
    printf '%s\n' '[3/6] Applying the latest canonical release update...' >&2
    "${ROOT}/scripts/update" --latest --allow-no-backup || return $?
  else
    printf '%s\n' '[3/6] No release update applied. Use --apply-update after reviewing the update check.' >&2
  fi

  printf '%s\n' '[4/6] Bootstrapping LocalClaw configuration and state...' >&2
  "${ROOT}/scripts/bootstrap" || return $?
  if [ -n "${secret_backend}" ]; then
    write_setup_config_key SECRET_BACKEND "${secret_backend}" || return $?
  fi
  if [ -n "${password_manager}" ]; then
    write_setup_config_key CREDENTIAL_PROVIDER "${password_manager}" || return $?
  fi
  printf '%s\n' '[5/6] Running the read-only doctor...' >&2
  "${ROOT}/scripts/doctor" || return $?

  if [ "${skip_tests}" -eq 0 ]; then
    printf '%s\n' '[6/6] Running the regression test suite...' >&2
    HOME="${HOME:-}" bash "${ROOT}/tests/run.sh" || return $?
  else
    printf '%s\n' '[6/6] Regression suite skipped by request.' >&2
  fi
  if [ "${skip_e2e}" -eq 0 ]; then
    printf '%s\n' 'Running the disposable end-to-end lifecycle test...' >&2
    bash "${ROOT}/tests/e2e/run.sh" || return $?
  else
    printf '%s\n' 'End-to-end test skipped by request.' >&2
  fi
  printf '%s\n' 'LocalClaw setup completed.' >&2
}
case "${1:-}" in
  setup) shift; setup "$@" ;;
  install|doctor|update|credentials|bootstrap|vault-start|vault-stop|vault-bootstrap|work-session|restore|uninstall)
    command="${ROOT}/scripts/${1}"; shift; exec "${command}" "$@" ;;
  backup)
    shift
    case "${1:-}" in
      verify) shift; exec "${ROOT}/scripts/credentials" backup-verify "$@" ;;
      *) exec "${ROOT}/scripts/backup" "$@" ;;
    esac ;;
  ''|-h|--help)
    usage
    [ "${1:-}" = '' ] && exit 2 || exit 0 ;;
  *) printf 'Unknown localclaw command: %s\n' "$1" >&2; exit 2 ;;
esac
