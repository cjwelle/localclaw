#!/usr/bin/env bash
# credentials - short-lived password-manager adapters for backup recovery.
#
# This script never stores, prints, or accepts a password-manager password.
# Native CLIs handle login/MFA. The age identity is written to an owner-only
# temporary file and deleted when this process exits.
set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
. "${SCRIPT_DIR}/lib/common.sh"
load_stack_config
pass() { printf '  [PASS] %s\n' "$*"; }
note() { printf '  [WARN] %s\n' "$*"; }

usage() {
  cat >&2 <<EOF
Usage:
  scripts/credentials status
  scripts/credentials configure --provider PROVIDER --ref REFERENCE
  scripts/credentials backup-verify ARCHIVE

Providers: bitwarden, 1password, lastpass.
The reference is a provider-native item/record reference. It must contain the
full age private identity in a secure Notes field. No password is stored here.
EOF
}

provider="${CREDENTIAL_PROVIDER}"
ref="${BACKUP_IDENTITY_REF}"
BW_WAS_UNLOCKED=0
LPASS_WAS_LOGGED_IN=0

write_config_key() {
  local key="$1" value="$2" file="${LOCALCLAW_STACK_CONF}" tmp
  [ -r "${file}" ] || fail "Missing ${file}; run scripts/bootstrap first."
  tmp="$(make_secure_tmpdir localclaw-config)/stack.conf"
  trap 'rm -rf "$(dirname "${tmp}")"' EXIT HUP INT TERM
  awk -v key="${key}" -v value="${value}" '
    BEGIN { done=0 }
    $0 ~ "^[[:space:]]*" key "=" {
      if (!done) { print key "=" value; done=1 }
      next
    }
    { print }
    END { if (!done) print key "=" value }
  ' "${file}" > "${tmp}" || fail "Unable to update ${file}."
  chmod 600 "${tmp}"
  mv "${tmp}" "${file}" || fail "Unable to install updated ${file}."
  trap - EXIT HUP INT TERM
}

provider_cli() {
  case "$1" in
    bitwarden) printf 'bw\n' ;;
    1password) printf 'op\n' ;;
    lastpass) printf 'lpass\n' ;;
    *) return 1 ;;
  esac
}

provider_status() {
  local p="$1" cli
  cli="$(provider_cli "${p}")" || fail "Unsupported provider: ${p}"
  have "${cli}" || { note "${p}: ${cli} is not installed"; return 0; }
  case "${p}" in
    bitwarden) "${cli}" status 2>/dev/null | jq -r '.status // "unknown"' 2>/dev/null || note "${p}: unable to read status" ;;
    1password) "${cli}" account list >/dev/null 2>&1 && pass "${p}: CLI available (locked state is not changed)" || note "${p}: no authenticated account reported" ;;
    lastpass) "${cli}" status >/dev/null 2>&1 && pass "${p}: CLI available (locked state is not changed)" || note "${p}: not logged in" ;;
  esac
}

retrieve_identity() {
  local p="$1" item="$2" output="$3" cli session
  cli="$(provider_cli "${p}")" || fail "Unsupported provider: ${p}"
  have "${cli}" || fail "${cli} is required for ${p}; install it and retry."
  [ -n "${item}" ] || fail "No backup identity reference configured."
  case "${p}" in
    bitwarden)
      if [ "$(bw status 2>/dev/null | jq -r '.status // empty' 2>/dev/null)" = "unlocked" ]; then
        BW_WAS_UNLOCKED=1
        session="${BW_SESSION:-}"
      else
        session="$(bw unlock --raw)" || fail "Bitwarden unlock failed."
      fi
      [ -n "${session}" ] || fail "Bitwarden returned no usable session. Set BW_SESSION when Bitwarden is already unlocked."
      BW_SESSION="${session}" bw get notes "${item}" > "${output}" || fail "Unable to read Bitwarden secure note: ${item}"
      unset session BW_SESSION
      [ "${BW_WAS_UNLOCKED}" -eq 1 ] || bw lock >/dev/null 2>&1 || true
      ;;
    1password)
      # op read prompts through the native 1Password integration/MFA flow.
      op read "${item}" > "${output}" || fail "Unable to read 1Password secret reference: ${item}"
      ;;
    lastpass)
      if lpass status >/dev/null 2>&1; then LPASS_WAS_LOGGED_IN=1; fi
      lpass login || fail "LastPass login failed."
      lpass show --notes "${item}" > "${output}" || fail "Unable to read LastPass secure note: ${item}"
      [ "${LPASS_WAS_LOGGED_IN}" -eq 1 ] || lpass logout >/dev/null 2>&1 || true
      ;;
  esac
  chmod 600 "${output}"
  grep -Eq '^[[:space:]]*AGE-SECRET-KEY-[A-Z0-9_-]+' "${output}" || fail "Retrieved record does not look like an age identity; refusing to use it."
}

case "${1:-}" in
  status)
    printf 'credential provider: %s\n' "${provider}"
    if [ "${provider}" = none ]; then
      note "No password-manager adapter configured."
    else
      provider_status "${provider}"
    fi
    ;;
  configure)
    shift
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --provider) [ "$#" -ge 2 ] || fail "--provider requires a value"; provider="$2"; shift ;;
        --ref) [ "$#" -ge 2 ] || fail "--ref requires a value"; ref="$2"; shift ;;
        *) usage; fail "Unknown option: $1" ;;
      esac
      shift
    done
    provider_cli "${provider}" >/dev/null || fail "Provider must be bitwarden, 1password, or lastpass."
    [ -n "${ref}" ] || fail "--ref is required."
    write_config_key CREDENTIAL_PROVIDER "${provider}"
    write_config_key BACKUP_IDENTITY_REF "${ref}"
    ok "Configured ${provider} backup-key adapter (reference only; no secret was stored)."
    ;;
  backup-verify)
    [ "$#" -eq 2 ] || { usage; fail "backup-verify requires exactly one archive path."; }
    [ "${provider}" != none ] || fail "Configure CREDENTIAL_PROVIDER first."
    tmp="$(make_secure_tmpdir localclaw-identity)"
    identity="${tmp}/age-identity"
    cleanup_credentials() {
      unset BW_SESSION OP_SESSION_lastpass OP_SESSION_my 2>/dev/null || true
      case "${provider}" in
        bitwarden) [ "${BW_WAS_UNLOCKED}" -eq 1 ] || bw lock >/dev/null 2>&1 || true ;;
        lastpass) [ "${LPASS_WAS_LOGGED_IN}" -eq 1 ] || lpass logout >/dev/null 2>&1 || true ;;
      esac
      [ -d "${tmp}" ] && rm -rf "${tmp}"
    }
    trap cleanup_credentials EXIT HUP INT TERM
    retrieve_identity "${provider}" "${ref}" "${identity}"
    "${SCRIPT_DIR}/restore" --identity "${identity}" "$2"
    ;;
  -h|--help|'') usage; [ "${1:-}" = '' ] && exit 2 || exit 0 ;;
  *) usage; fail "Unknown command: $1" ;;
esac
