#!/usr/bin/env bash
# install - platform-aware prerequisite installer for the local stack.
#
# SAFE BY DEFAULT. With no flags this script only PLANS: it first inventories
# every prerequisite, then prints the exact package-manager commands it would
# run. It changes nothing until you pass --apply.
#
# It never pipes a network download into a shell (no `curl | sh`). On Debian/
# Ubuntu it adds HashiCorp's apt repository the documented way (fetch the GPG
# key to a keyring file, then apt-get install); every privileged step is shown
# first and only executed under --apply with a typed confirmation.
#
# It installs package-manager software:
#   vault, sqlite3, age/age-keygen, jq, git, curl, tmux, tar, checksum tools,
#   and the selected password-manager CLI,
#   and (optionally) shellcheck.
# It then installs OpenClaw's official npm package from the `extended-stable`
# dist-tag when it is missing. It does NOT start any service, register a
# scheduler, initialize git, or touch your credentials.
#
# Usage:
#   scripts/install               # plan only (default): print what it would do
#   scripts/install --apply       # actually install, after a typed confirmation
#   scripts/install --secret-backend password-manager --password-manager bitwarden
#   scripts/install --help
set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=scripts/lib/common.sh
. "${SCRIPT_DIR}/lib/common.sh"
load_stack_config

APPLY=0
SECRET_BACKEND="${SECRET_BACKEND:-vault}"
SECRET_BACKEND_SET=0
PASSWORD_MANAGER="${CREDENTIAL_PROVIDER:-none}"
PASSWORD_MANAGER_SET=0
PASSWORD_MANAGER_CONFIGURED=0
# common.sh initializes CREDENTIAL_PROVIDER=none as a default. That default is
# not evidence that the operator has made a selection; only an explicit config
# entry should suppress the first-run prompt.
if [ -r "${LOCALCLAW_STACK_CONF}" ] && grep -Eq '^[[:space:]]*CREDENTIAL_PROVIDER[[:space:]]*=' "${LOCALCLAW_STACK_CONF}"; then
  PASSWORD_MANAGER_CONFIGURED=1
fi
any=0   # set to 1 whenever a plan step proposes an install
confirmed=0

usage() {
  cat >&2 <<EOF
Usage: scripts/install [--apply] [--secret-backend vault|password-manager]
                        [--password-manager none|bitwarden|1password|lastpass]

  (no flags)   Plan only. Detect OS, report present/missing tools, and print
               the exact commands that --apply would run. Makes no changes.
  --password-manager PROVIDER
               Select which password-manager CLI to check/install. It is
               optional in Vault mode and required in password-manager mode.
  --secret-backend BACKEND
               Select vault (default) or password-manager for session secrets.
  --apply      Run the install commands for missing tools after you type a
               confirmation. Never pipes downloads into a shell.
  --help       Show this help.

Manages: vault, sqlite3, age, jq, git, curl, tmux, tar, checksum tools,
the selected password-manager CLI, optional shellcheck, and OpenClaw's
official npm extended-stable package.
EOF
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --apply) APPLY=1 ;;
    --secret-backend)
      [ "$#" -ge 2 ] || { usage; fail "--secret-backend requires a value"; }
      SECRET_BACKEND="$2"; SECRET_BACKEND_SET=1; shift ;;
    --password-manager)
      [ "$#" -ge 2 ] || { usage; fail "--password-manager requires a value"; }
      PASSWORD_MANAGER="$2"; PASSWORD_MANAGER_SET=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *) usage; fail "Unknown argument: $1" ;;
  esac
  shift
done

case "${PASSWORD_MANAGER}" in
  none|bitwarden|1password|lastpass) : ;;
  *) usage; fail "Unsupported password manager: ${PASSWORD_MANAGER}" ;;
esac
case "${SECRET_BACKEND}" in
  vault|password-manager) : ;;
  *) usage; fail "Unsupported secret backend: ${SECRET_BACKEND}" ;;
esac
if [ "${SECRET_BACKEND}" = "password-manager" ] && [ "${PASSWORD_MANAGER}" = "none" ]; then
  if [ "${PASSWORD_MANAGER_SET}" -eq 0 ] && [ -t 0 ]; then
    printf 'Which password manager should provide session secrets? [bitwarden/1password/lastpass]: ' >&2
    IFS= read -r answer || answer=""
    [ -n "${answer}" ] && PASSWORD_MANAGER="${answer}"
  fi
  case "${PASSWORD_MANAGER}" in
    bitwarden|1password|lastpass) : ;;
    *) fail "SECRET_BACKEND=password-manager requires --password-manager bitwarden, 1password, or lastpass." ;;
  esac
fi
if [ "${PASSWORD_MANAGER_SET}" -eq 0 ] && [ "${PASSWORD_MANAGER_CONFIGURED}" -eq 0 ] && [ -t 0 ]; then
  printf 'Which password manager should LOCALCLAW support? [none/bitwarden/1password/lastpass] (none): ' >&2
  IFS= read -r answer || answer=""
  [ -n "${answer}" ] && PASSWORD_MANAGER="${answer}"
  case "${PASSWORD_MANAGER}" in
    none|bitwarden|1password|lastpass) : ;;
    *) fail "Unsupported password manager: ${PASSWORD_MANAGER}" ;;
  esac
fi
if [ "${PASSWORD_MANAGER_SET}" -eq 0 ] && [ "${PASSWORD_MANAGER_CONFIGURED}" -eq 1 ]; then
  info "Using configured password manager: ${PASSWORD_MANAGER}"
fi

os="$(detect_os)"
info "Detected operating system: ${os}"
info "Secret backend: ${SECRET_BACKEND}"

# Bootstrap prerequisites: Homebrew is the macOS package-manager entry point,
# and Git is needed to obtain/update the repository. Fail before any package
# manager action so a fresh machine gets a clear next step.
if [ "${os}" = macos ] && ! have brew; then
  fail "Homebrew is required before running LocalClaw on macOS. Install it from https://brew.sh/ (review the official instructions), then rerun this command."
fi
if ! have git; then
  fail "Git is required before running LocalClaw. Install it from https://git-scm.com/downloads or, on macOS, install Apple's Command Line Tools with 'xcode-select --install', then rerun this command."
fi

if [ "${APPLY}" -eq 1 ]; then
  info "Mode: APPLY (commands will run after confirmation)."
else
  info "Mode: PLAN (no changes will be made). Re-run with --apply to install."
fi

# Read-only inventory runs before any package-manager command. The complete
# starting state is visible before an operator approves the apply phase.
report_prereq() {
  local label="$1" bin="$2"
  if have "${bin}"; then
    ok "${label}: present ($(command -v "${bin}"))"
  else
    warn "${label}: MISSING (apply will install it when supported)"
  fi
}

bounded_command() {
  # bounded_command <seconds> <command> [args...]
  # Avoid a provider CLI hanging the prerequisite scan indefinitely.
  local seconds="$1"; shift
  if have perl; then
    perl -e 'alarm shift; exec @ARGV' "${seconds}" "$@"
  elif have python3; then
    python3 - "${seconds}" "$@" <<'PY'
import subprocess
import sys

seconds = int(sys.argv[1])
raise SystemExit(subprocess.call(sys.argv[2:], timeout=seconds))
PY
  else
    return 125
  fi
}

report_bitwarden_session() {
  if ! have bw; then
    return 0
  fi
  local status_json status
  if ! status_json="$(bounded_command 5 bw status 2>/dev/null)"; then
    warn "Bitwarden session: status check timed out or failed; run 'bw status' manually"
    return 0
  fi
  status="$(printf '%s' "${status_json}" | sed -n 's/.*"status"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')"
  case "${status}" in
    unlocked) ok "Bitwarden session: logged in and unlocked" ;;
    locked) warn "Bitwarden session: logged in but locked (run 'bw unlock')" ;;
    unauthenticated) warn "Bitwarden session: not logged in (run 'bw login')" ;;
    *) warn "Bitwarden session: unable to determine status; run 'bw status'" ;;
  esac
}

check_prerequisites() {
  local package_manager="apt-get"
  [ "${os}" = macos ] && package_manager="brew"
  printf '\n== Prerequisite check (read-only; before installation) ==\n' >&2
  report_prereq "package manager" "${package_manager}"
  report_prereq "Vault" vault
  report_prereq "sqlite3" sqlite3
  report_prereq "node" node
  report_prereq "npm" npm
  report_prereq "jq" jq
  report_prereq "git" git
  report_prereq "curl" curl
  report_prereq "tmux" tmux
  report_prereq "tar" tar
  if have shasum || have sha256sum; then
    ok "checksum tool: present"
  else
    warn "checksum tool (shasum/sha256sum): MISSING (apply will install it when supported)"
  fi
  if have age && have age-keygen; then
    ok "age/age-keygen: present"
  else
    warn "age/age-keygen: MISSING (apply will install age)"
  fi
  report_prereq "OpenClaw" "${OPENCLAW_BIN}"
  # Always inventory all supported CLIs so a non-interactive run cannot make
  # an unselected provider look as though it was checked. Only the selected
  # provider is included in the installation plan below.
  printf '%s\n' 'Password-manager CLI inventory:' >&2
  report_prereq "Bitwarden CLI (bw)" bw
  if [ "${PASSWORD_MANAGER}" = bitwarden ]; then
    report_bitwarden_session
  else
    info "Bitwarden session check skipped (select --password-manager bitwarden to check login state)"
  fi
  report_prereq "1Password CLI (op)" op
  report_prereq "LastPass CLI (lpass)" lpass
  info "Selected password manager for installation: ${PASSWORD_MANAGER}"
  info "Prerequisite check complete; no installation occurred during this phase."
}

check_prerequisites

# A tool is "needed" only if its binary is not already on PATH.
need_tool() { have "$1" && return 1 || return 0; }

# Print a command plan line; run it only under --apply.
run_step() {
  # run_step "<human description>" cmd arg...
  local desc="$1"; shift
  printf '    $ %s\n' "$*" >&2
  if [ "${APPLY}" -eq 1 ]; then
    "$@" || fail "Step failed: ${desc}"
  fi
}

confirm_apply() {
  [ "${APPLY}" -eq 1 ] || return 0
  [ "${confirmed}" -eq 0 ] || return 0
  warn "About to install software with your system package manager (may require sudo)."
  require_typed_confirmation "INSTALL" "Type INSTALL to proceed"
  confirmed=1
}

configure_backup_dir() {
  # Backups are opt-in. Never prompt or write config during plan mode or when
  # stdin is not an interactive terminal.
  [ "${APPLY}" -eq 1 ] || return 0
  [ -t 0 ] || return 0
  [ -n "${BACKUP_DIR}" ] && return 0

  local answer choice os
  os="$(detect_os)"
  printf '\nWhere should encrypted Vault backups be stored?\n' >&2
  if [ "${os}" = macos ]; then
    printf '  1) iCloud Drive     (%s)\n' "${HOME}/Library/Mobile Documents/com~apple~CloudDocs/LocalClawBackups" >&2
    printf '  2) Cloud storage    (%s)\n' "${HOME}/CloudStorage/LocalClawBackups" >&2
    printf '  3) Local home folder (%s)\n' "${HOME}/localclaw-backups" >&2
    printf '  4) Custom absolute path\n' >&2
    printf '  5) Disable backups\n' >&2
    printf '  6) Set up backups later\n' >&2
    printf 'Choose [1-6] (6): ' >&2
    IFS= read -r choice || choice="6"
    case "${choice}" in
      1) answer="${HOME}/Library/Mobile Documents/com~apple~CloudDocs/LocalClawBackups" ;;
      2) answer="${HOME}/CloudStorage/LocalClawBackups" ;;
      3) answer="${HOME}/localclaw-backups" ;;
      4) printf 'Custom backup directory (absolute path): ' >&2; IFS= read -r answer || answer="" ;;
      5) answer="" ;;
      6|'') answer=""; info "Backup setup deferred. Re-run './scripts/install --apply' later to choose a destination." ;;
      /*) answer="${choice}" ;;
      *) fail "Choose a number from 1 to 5; backups remain disabled." ;;
    esac
  else
    printf '  1) Local home folder (%s)\n' "${HOME}/localclaw-backups" >&2
    printf '  2) Custom absolute path\n' >&2
    printf '  3) Disable backups\n' >&2
    printf '  4) Set up backups later\n' >&2
    printf 'Choose [1-4] (4): ' >&2
    IFS= read -r choice || choice="4"
    case "${choice}" in
      1) answer="${HOME}/localclaw-backups" ;;
      2) printf 'Custom backup directory (absolute path): ' >&2; IFS= read -r answer || answer="" ;;
      3) answer="" ;;
      4|'') answer=""; info "Backup setup deferred. Re-run './scripts/install --apply' later to choose a destination." ;;
      /*) answer="${choice}" ;;
      *) fail "Choose a number from 1 to 3; backups remain disabled." ;;
    esac
  fi
  [ -n "${answer}" ] || {
    info "Encrypted backups remain disabled (BACKUP_DIR is empty)."
    return 0
  }
  case "${answer}" in
    /*) : ;;
    *) fail "Backup directory must be an absolute path; backups remain disabled." ;;
  esac
  validate_backup_dir "${answer}"
  ensure_private_dir "${answer}"
  mkdir -p "${LOCALCLAW_CONFIG_DIR}" || fail "Could not create ${LOCALCLAW_CONFIG_DIR}."
  chmod 700 "${LOCALCLAW_CONFIG_DIR}" 2>/dev/null || true
  printf '\n# Encrypted Vault backup destination (configured by scripts/install)\nBACKUP_DIR=%s\n' \
    "${answer}" >> "${LOCALCLAW_STACK_CONF}" \
    || fail "Could not save BACKUP_DIR to ${LOCALCLAW_STACK_CONF}."
  chmod 600 "${LOCALCLAW_STACK_CONF}" 2>/dev/null || true
  BACKUP_DIR="${answer}"
  ok "Encrypted backups enabled: ${BACKUP_DIR}"
}

install_vault_from_tap() {
  # Homebrew imports every formula in a tap before installing one formula.
  # Some historical HashiCorp taps contain a broken vagrant.rb that prevents
  # Vault from being imported. Temporarily move only that unrelated formula
  # aside for this command, then restore it regardless of the result.
  local tap_dir backup_dir formula backup status
  if [ "${APPLY}" -eq 0 ]; then
    run_step "install vault" brew install hashicorp/tap/vault
    return $?
  fi
  tap_dir="$(brew --repo hashicorp/tap 2>/dev/null || true)"
  formula="${tap_dir}/Formula/vagrant.rb"
  if [ -z "${tap_dir}" ] || [ ! -f "${formula}" ]; then
    run_step "install vault" brew install hashicorp/tap/vault
    return $?
  fi

  backup_dir="$(mktemp -d "${TMPDIR:-/tmp}/localclaw-vagrant.XXXXXX")" \
    || fail "Could not create a temporary backup for the broken HashiCorp formula."
  backup="${backup_dir}/vagrant.rb"
  if ! mv "${formula}" "${backup}"; then
    rmdir "${backup_dir}" 2>/dev/null || true
    fail "Could not quarantine the broken HashiCorp vagrant.rb."
  fi
  info "Temporarily excluding broken hashicorp/tap Formula/vagrant.rb while installing Vault."
  printf '    $ brew install hashicorp/tap/vault\n' >&2
  brew install hashicorp/tap/vault
  status=$?
  mv "${backup}" "${formula}" 2>/dev/null || warn "Could not restore ${formula}; backup remains at ${backup}"
  rmdir "${backup_dir}" 2>/dev/null || true
  [ "${status}" -eq 0 ] || fail "Step failed: install vault"
}

# ---------------------------------------------------------------------------
# OpenClaw npm install (shared by both platforms). It runs only after the same
# explicit INSTALL confirmation used for system packages.
# ---------------------------------------------------------------------------
plan_openclaw() {
  printf '\n== OpenClaw (official npm package) ==\n' >&2
  if have "${OPENCLAW_BIN}"; then
    ok "openclaw: present ($(command -v "${OPENCLAW_BIN}"))"
    return 0
  fi
  any=1
  warn "openclaw: MISSING. It will be installed from npm after Node/npm is ready."
  # Pin the 'extended-stable' release channel by default for stability, not the
  # rolling '@latest' tag. Operators who want a different channel may override
  # it explicitly (see https://docs.openclaw.ai/install/development-channels).
  printf '    $ npm install -g openclaw@extended-stable\n' >&2
  info "This pins the 'extended-stable' channel for stability (not @latest)."
  info "To move channels later:  openclaw update --channel extended-stable"
  info "Channels are documented at https://docs.openclaw.ai/install/development-channels"
  warn "Do NOT curl-pipe an install script. Review any installer before running it."
  if [ "${APPLY}" -eq 1 ]; then
    have npm || fail "npm is still unavailable after dependency installation. Install Node/npm and retry."
    confirm_apply
    run_step "install OpenClaw extended-stable" npm install -g openclaw@extended-stable
    have "${OPENCLAW_BIN}" || fail "npm completed but '${OPENCLAW_BIN}' is not on PATH. Check your npm global prefix."
  fi
  warn "Keep sessions FOREGROUND-only (no gateway service)."
}

# ===========================================================================
# macOS (Homebrew)
# ===========================================================================

# plan_brew <bin> <formula> <label> <required:1|optional:0>
plan_brew() {
  local bin="$1" formula="$2" label="$3" required="$4"
  if ! need_tool "${bin}"; then
    ok "${label}: present ($(command -v "${bin}"))"
    return 0
  fi
  any=1
  if [ "${required}" -eq 1 ]; then
    info "${label}: MISSING -> will install '${formula}'"
    confirm_apply
    run_step "install ${formula}" brew install "${formula}"
  else
    info "${label}: MISSING (optional) -> would install '${formula}'"
    if [ "${APPLY}" -eq 1 ]; then
      confirm_apply
      run_step "install ${formula}" brew install "${formula}"
    else
      printf '    $ brew install %s   # optional\n' "${formula}" >&2
    fi
  fi
}

plan_password_manager_brew() {
  case "${PASSWORD_MANAGER}" in
    none) info "No password-manager CLI selected" ;;
    bitwarden) plan_brew bw bitwarden-cli "Bitwarden CLI" 1 ;;
    1password) plan_brew op 1password-cli "1Password CLI" 1 ;;
    lastpass) plan_brew lpass lastpass-cli "LastPass CLI" 1 ;;
  esac
}

plan_macos() {
  have brew || fail "Homebrew (brew) is required on macOS but was not found. Install it from https://brew.sh/ first (review the instructions yourself; this script will not curl-pipe a shell)."

  printf '\n== macOS (Homebrew) plan ==\n' >&2

  # Vault comes from the HashiCorp tap, not a plain formula.
  if need_tool vault; then
    any=1
    info "vault: MISSING -> will refresh hashicorp/tap, then install Vault"
    confirm_apply
    # Older Homebrew taps can contain formulas that fail to import (for
    # example, a stale vagrant.rb) before Homebrew reaches Vault. Refresh only
    # this tap; do not reset Homebrew or modify unrelated taps.
    if [ "${APPLY}" -eq 1 ]; then
      # Do not run `brew tap`/`brew tap-list` while planning: Homebrew loads
      # every formula in the tap and an old broken formula can hang or fail
      # before LocalClaw has made any change.
      brew untap hashicorp/tap 2>/dev/null || true
      tap_log="$(mktemp "${TMPDIR:-/tmp}/localclaw-tap.XXXXXX")" \
        || fail "Could not create a temporary Homebrew tap log."
      if ! brew tap hashicorp/tap >"${tap_log}" 2>&1; then
        if grep -q 'vagrant\.rb' "${tap_log}"; then
          warn "Ignoring the known broken hashicorp/tap vagrant.rb; Vault will be installed separately from that formula."
        else
          cat "${tap_log}" >&2
          warn "Homebrew could not import hashicorp/tap."
        fi
        run_step "update Homebrew" brew update
        run_step "repair hashicorp/tap" brew tap --repair
      fi
      rm -f "${tap_log}"
    else
      # Plan mode must remain read-only and must not invoke any tap command.
      printf '    $ brew tap hashicorp/tap\n' >&2
      printf '    # If tap import fails, run: brew update && brew tap --repair\n' >&2
    fi
    run_step "install vault"      brew install hashicorp/tap/vault
  else
    ok "vault: present ($(command -v vault))"
  fi

  # 'age' provides both age and age-keygen.
  if need_tool age || need_tool age-keygen; then
    any=1
    info "age/age-keygen: MISSING -> will install 'age' (provides both)"
    confirm_apply
    run_step "install age"        brew install age
  else
    ok "age/age-keygen: present"
  fi

  # 'node' provides node and npm (needed to install OpenClaw yourself).
  plan_brew node     node   "node/npm" 1
  plan_brew sqlite3  sqlite "sqlite3"  1
  plan_brew jq       jq     "jq"       1
  plan_brew git      git    "git"      1
  plan_brew curl     curl   "curl"     1
  plan_brew tmux     tmux   "tmux"     1
  # tar ships with macOS; only note if somehow absent.
  if need_tool tar; then plan_brew tar gnu-tar "tar" 1; else ok "tar: present"; fi
  if have shasum || have sha256sum; then ok "checksum tool: present"; else plan_brew sha256sum coreutils "checksum tool" 1; fi
  plan_password_manager_brew

  # ShellCheck is only for contributors.
  plan_brew shellcheck shellcheck "shellcheck" 0

  [ "${any}" -eq 1 ] || ok "All required Homebrew packages already present."
  warn "Do NOT register Vault as a service. This stack runs Vault in the foreground only."
}

# ===========================================================================
# Debian / Ubuntu (apt)
# ===========================================================================
plan_debian() {
  have apt-get || fail "apt-get is required on Debian/Ubuntu but was not found."

  local keyring="/usr/share/keyrings/hashicorp-archive-keyring.gpg"
  printf '\n== Debian/Ubuntu (apt) plan ==\n' >&2

  local need_vault=0
  need_tool vault && need_vault=1

  if [ "${need_vault}" -eq 1 ]; then
    any=1
    info "vault: MISSING -> will add HashiCorp's apt repository, then install"
    warn "The GPG key is fetched to a keyring file with curl+gpg (NOT piped to a shell)."
    printf '    $ sudo apt-get update\n' >&2
    printf '    $ sudo apt-get install -y gpg curl lsb-release ca-certificates\n' >&2
    printf '    $ curl -fsSL https://apt.releases.hashicorp.com/gpg | sudo gpg --dearmor -o %s\n' "${keyring}" >&2
    printf '    $ echo "deb [signed-by=%s] https://apt.releases.hashicorp.com <codename> main" | sudo tee /etc/apt/sources.list.d/hashicorp.list\n' "${keyring}" >&2
  else
    ok "vault: present ($(command -v vault))"
  fi

  # Distro packages. Note the bin->package mapping: node/npm come from
  # 'nodejs' + 'npm'; everything else maps to a like-named package.
  local pkgs="" t arch
  arch="$(dpkg --print-architecture 2>/dev/null || printf amd64)"
  need_tool node && pkgs="${pkgs} nodejs"
  need_tool npm  && pkgs="${pkgs} npm"
  for t in sqlite3 jq git curl tmux age tar; do
    if need_tool "${t}"; then pkgs="${pkgs} ${t}"; fi
  done
  if ! have shasum && ! have sha256sum; then pkgs="${pkgs} coreutils"; fi
  case "${PASSWORD_MANAGER}" in
    lastpass) need_tool lpass && pkgs="${pkgs} lastpass-cli" ;;
    bitwarden) if need_tool bw; then info "Bitwarden CLI: missing -> install official npm CLI after Node/npm"; fi ;;
    1password) if need_tool op; then
      info "1Password CLI: missing -> will add the official 1Password apt repository"
      printf '    $ curl -sS https://downloads.1password.com/linux/keys/1password.asc | gpg --dearmor | sudo tee /usr/share/keyrings/1password-archive-keyring.gpg >/dev/null\n' >&2
      printf '    $ echo "deb [arch=%s signed-by=/usr/share/keyrings/1password-archive-keyring.gpg] https://downloads.1password.com/linux/debian/%s stable main" | sudo tee /etc/apt/sources.list.d/1password.list\n' "${arch}" "${arch}" >&2
      printf '    $ sudo apt-get update && sudo apt-get install -y 1password-cli\n' >&2
    fi ;;
  esac

  if [ -n "${pkgs}" ]; then
    any=1
    info "distro packages to install:${pkgs}"
    printf '    $ sudo apt-get update\n' >&2
    # shellcheck disable=SC2086
    printf '    $ sudo apt-get install -y%s\n' "${pkgs}" >&2
  else
    ok "node/npm, sqlite3, jq, git, curl, tmux, age, tar: present"
  fi

  if need_tool shellcheck; then
    printf '    $ sudo apt-get install -y shellcheck   # optional, for contributors\n' >&2
  else
    ok "shellcheck: present (optional)"
  fi

  if [ "${APPLY}" -eq 1 ]; then
    confirm_apply
    run_step "apt-get update (prereqs)"  sudo apt-get update
    run_step "install apt prereqs"       sudo apt-get install -y gpg curl lsb-release ca-certificates
    if [ "${need_vault}" -eq 1 ]; then
      # Fetch key to a keyring file (curl -> gpg --dearmor), never curl | sh.
      info "Adding HashiCorp GPG key to ${keyring}"
      curl -fsSL https://apt.releases.hashicorp.com/gpg | sudo gpg --dearmor -o "${keyring}" \
        || fail "Failed to fetch/install HashiCorp GPG key."
      codename="$(lsb_release -cs 2>/dev/null || echo stable)"
      printf 'deb [signed-by=%s] https://apt.releases.hashicorp.com %s main\n' "${keyring}" "${codename}" \
        | sudo tee /etc/apt/sources.list.d/hashicorp.list >/dev/null \
        || fail "Failed to add HashiCorp apt source."
    fi
    run_step "apt-get update (repos)"    sudo apt-get update
    # Assemble the final install list from what is still missing.
    install_list=""
    [ "${need_vault}" -eq 1 ] && install_list="${install_list} vault"
    need_tool node && install_list="${install_list} nodejs"
    need_tool npm  && install_list="${install_list} npm"
    for t in sqlite3 jq git curl tmux age tar; do
      need_tool "${t}" && install_list="${install_list} ${t}"
    done
    if ! have shasum && ! have sha256sum; then install_list="${install_list} coreutils"; fi
    if [ "${PASSWORD_MANAGER}" = lastpass ] && need_tool lpass; then install_list="${install_list} lastpass-cli"; fi
    if [ -n "${install_list}" ]; then
      # shellcheck disable=SC2086
      run_step "install packages" sudo apt-get install -y ${install_list}
    fi
    if [ "${PASSWORD_MANAGER}" = bitwarden ] && need_tool bw; then
      have npm || fail "npm is required to install the Bitwarden CLI."
      run_step "install Bitwarden CLI" npm install -g @bitwarden/cli
    fi
    if [ "${PASSWORD_MANAGER}" = 1password ] && need_tool op; then
      have gpg || fail "gpg is required to install the 1Password CLI repository key."
      case "${arch}" in amd64|arm64) : ;; *) fail "Unsupported Debian architecture for 1Password CLI: ${arch}" ;; esac
      keyring_1p="/usr/share/keyrings/1password-archive-keyring.gpg"
      curl -sS https://downloads.1password.com/linux/keys/1password.asc | gpg --dearmor | sudo tee "${keyring_1p}" >/dev/null \
        || fail "Failed to install the 1Password repository key."
      printf 'deb [arch=%s signed-by=%s] https://downloads.1password.com/linux/debian/%s stable main\n' "${arch}" "${keyring_1p}" "${arch}" \
        | sudo tee /etc/apt/sources.list.d/1password.list >/dev/null \
        || fail "Failed to add the 1Password apt source."
      run_step "apt-get update (1Password repo)" sudo apt-get update
      run_step "install 1Password CLI" sudo apt-get install -y 1password-cli
    fi
  fi

  warn "Installing the 'vault' apt package may create a systemd unit. This stack does NOT use it."
  warn "Ensure it is not enabled or running:  sudo systemctl disable --now vault 2>/dev/null || true"
}

case "${os}" in
  macos) plan_macos ;;
  linux) plan_debian ;;
  *)     fail "Unsupported operating system. Only macOS (Homebrew) and Debian/Ubuntu (apt) are supported." ;;
esac

plan_openclaw

printf '\n== Encrypted backups ==\n' >&2
if [ "${APPLY}" -eq 1 ] && [ -z "${BACKUP_DIR}" ] && [ -t 0 ]; then
  configure_backup_dir
elif [ -n "${BACKUP_DIR}" ]; then
  info "Backup directory already configured: ${BACKUP_DIR}"
else
  info "Backups disabled (set BACKUP_DIR during an interactive --apply run)."
fi

printf '\n== Password-manager selection ==\n' >&2
case "${PASSWORD_MANAGER}" in
  none) info "No password-manager CLI selected." ;;
  bitwarden) info "Selected: Bitwarden CLI (bw)" ;;
  1password) info "Selected: 1Password CLI (op)" ;;
  lastpass) info "Selected: LastPass CLI (lpass)" ;;
esac

printf '\n' >&2
if [ "${APPLY}" -eq 1 ]; then
  ok "Install steps complete."
  info "Next steps:"
  info "  1. Run './localclaw doctor' to verify the installation."
  info "  2. Run './localclaw bootstrap' to create your owner-only config and state."
  info "  3. Review and edit the generated stack.conf and secrets.map."
  info "  4. Follow docs/QuickStartInstall.md to initialize Vault, then run './localclaw setup' on future machines."
else
  info "Plan complete. Nothing was changed. Re-run with --apply to install."
  info "After installation, run './localclaw doctor', then './localclaw bootstrap' to set up config/state."
fi
exit 0
