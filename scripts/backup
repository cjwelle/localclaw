#!/usr/bin/env bash
# backup - consistent, age-encrypted Vault Raft snapshot backup.
#
# This takes a CONSISTENT Vault Raft snapshot, packages it with the NON-SECRET
# stack config and policies plus a manifest of checksums, encrypts the whole
# tarball to a public `age` recipient, and writes ONLY the resulting ciphertext
# into the operator-chosen BACKUP_DIR (atomic Daily/ + Weekly/ writes). All
# staging happens in an owner-only temporary directory that is removed on exit.
#
# It is normally invoked by scripts/work-session during guarded session exit,
# with a dedicated snapshot-only backup token supplied as LOCAL_VAULT_TOKEN. It
# can also be run by hand against an already-running, unsealed local Vault.
#
# It NEVER packages: the live Vault Raft data directory, any credential/token/
# unseal share, the private `age` identity, or runtime logs. There is no
# plaintext staging copy inside BACKUP_DIR.
#
# Usage:
#   scripts/backup                 # take + encrypt a snapshot (once per day unless forced)
#   scripts/backup --force         # take a snapshot even if one already ran today
#   scripts/backup --dry-run       # validate config/destination only; touch no Vault
#   scripts/backup --help
#
# Environment:
#   LOCAL_VAULT_TOKEN        (required for a real run) snapshot-capable token.
#   BACKUP_VERIFY_IDENTITY   (optional) path to a private age identity used
#                            ONLY to verify the ciphertext decrypts locally.
#                            It is read, never copied into the archive.
#
# Written to be portable across Bash 3.2 (macOS system Bash) and modern Bash.
set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=scripts/lib/common.sh
. "${SCRIPT_DIR}/lib/common.sh"
load_stack_config

FORCE=0
DRY_RUN=0

usage() {
  cat >&2 <<EOF
Usage: scripts/backup [--force|--dry-run]

  (no flags)   Take a consistent Vault Raft snapshot, encrypt it to your age
               recipient, and write ciphertext to BACKUP_DIR/{Daily,Weekly}.
               Skips if a backup already succeeded today (see --force).
  --force      Take a snapshot even if one already succeeded today.
  --dry-run    Validate config, destination safety, and the age recipient.
               Does NOT contact Vault and writes nothing.
  --help       Show this help.

Requires (real run): a running, unsealed local Vault and a snapshot-capable
LOCAL_VAULT_TOKEN. Writes ONLY age-encrypted ciphertext; never a plaintext copy
and never the live Raft data directory, credentials, the private age identity,
or runtime logs.
EOF
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --force)   FORCE=1 ;;
    --dry-run) DRY_RUN=1 ;;
    -h|--help) usage; exit 0 ;;
    *) usage; fail "Unknown argument: $1" ;;
  esac
  shift
done
if [ "${FORCE}" -eq 1 ] && [ "${DRY_RUN}" -eq 1 ]; then
  fail "--force and --dry-run are mutually exclusive."
fi

# ---------------------------------------------------------------------------
# Validate configuration that both dry-run and a real run depend on.
# ---------------------------------------------------------------------------
[ -n "${BACKUP_DIR}" ] || fail "BACKUP_DIR is not set in stack.conf; backups are disabled."
# validate_backup_dir refuses empty/relative/'..'/system dirs, /, HOME, the repo,
# and the runtime state directory, and requires a writable dir if it exists.
validate_backup_dir "${BACKUP_DIR}"
validate_age_recipient_file "${LOCALCLAW_AGE_RECIPIENT_FILE}"

# Retention counts must be plain non-negative integers.
case "${BACKUP_KEEP_DAILY}"  in ''|*[!0-9]*) fail "BACKUP_KEEP_DAILY must be a number: ${BACKUP_KEEP_DAILY}" ;; esac
case "${BACKUP_KEEP_WEEKLY}" in ''|*[!0-9]*) fail "BACKUP_KEEP_WEEKLY must be a number: ${BACKUP_KEEP_WEEKLY}" ;; esac

DAILY_DIR="${BACKUP_DIR}/Daily"
WEEKLY_DIR="${BACKUP_DIR}/Weekly"
DAILY_GLOB='openclaw-vault-*.tar.gz.age'
WEEKLY_GLOB='openclaw-vault-weekly-*.tar.gz.age'

if [ "${DRY_RUN}" -eq 1 ]; then
  info "Backup dry run."
  ok "BACKUP_DIR is a safe destination: ${BACKUP_DIR}"
  ok "age recipient present and well-formed: ${LOCALCLAW_AGE_RECIPIENT_FILE}"
  info "Would write Daily/ and Weekly/ archives under BACKUP_DIR."
  info "Retention: keep newest ${BACKUP_KEEP_DAILY} daily and ${BACKUP_KEEP_WEEKLY} weekly archive(s)."
  info "Vault was not contacted and nothing was written."
  exit 0
fi

# ---------------------------------------------------------------------------
# Real run: preconditions.
# ---------------------------------------------------------------------------
have "${AGE_BIN}" || fail "age binary not found: ${AGE_BIN}. Run scripts/install."
have tar          || fail "tar not found."
have "${VAULT_BIN}" || fail "vault binary not found: ${VAULT_BIN}."
[ -n "${LOCAL_VAULT_TOKEN:-}" ] || fail "LOCAL_VAULT_TOKEN is required for a real backup (snapshot-capable token)."

# Refuse a sealed/absent Vault -- a snapshot of a sealed Vault is meaningless.
vault_require_unsealed

# Non-secret inputs that go INTO the archive. They must exist; refuse to make a
# misleading backup that silently omits the config it claims to include.
for f in "${LOCALCLAW_VAULT_HCL}" "${LOCALCLAW_STACK_CONF}" "${LOCALCLAW_OPENCLAW_JSON}"; do
  [ -r "${f}" ] || fail "Expected rendered config is missing: ${f}. Run scripts/bootstrap."
done
POLICY_DIR="${LOCALCLAW_REPO_DIR}/policies"
[ -d "${POLICY_DIR}" ] || fail "Policy directory missing: ${POLICY_DIR}"

# ---------------------------------------------------------------------------
# Once-per-day guard (unless --force). Records "YYYY-MM-DD|archive-name".
# ---------------------------------------------------------------------------
today="$(date +%Y-%m-%d)"
if [ "${FORCE}" -eq 0 ] && [ -r "${LOCALCLAW_LAST_BACKUP_FILE}" ]; then
  last_record="$(cat "${LOCALCLAW_LAST_BACKUP_FILE}" 2>/dev/null || true)"
  last_date="${last_record%%|*}"
  last_name="${last_record#*|}"
  if [ -n "${last_name}" ] && [ "${last_name}" != "${last_record}" ] \
     && [ "${last_date}" = "${today}" ] && [ -s "${DAILY_DIR}/${last_name}" ]; then
    ok "Encrypted Vault backup already completed today: ${DAILY_DIR}/${last_name}"
    info "Re-run with --force to take an additional same-day snapshot."
    exit 0
  fi
fi

# ---------------------------------------------------------------------------
# Owner-only staging. Everything below umask 077; removed on any exit.
# ---------------------------------------------------------------------------
umask 077
BACKUP_TMP="$(make_secure_tmpdir openclaw-vault-backup)"
# shellcheck disable=SC2329 # invoked by trap
cleanup() {
  trap - EXIT HUP INT TERM
  [ -n "${BACKUP_TMP:-}" ] && [ -d "${BACKUP_TMP}" ] && rm -rf "${BACKUP_TMP}"
}
trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

timestamp="$(TZ=UTC date +%Y%m%dT%H%M%SZ)"
weekly_period="$(TZ=UTC date +%G-W%V 2>/dev/null || TZ=UTC date +%Y-W%W)"
archive_name="openclaw-vault-${timestamp}.tar.gz.age"
weekly_name="openclaw-vault-weekly-${weekly_period}.tar.gz.age"

STAGE="${BACKUP_TMP}/stage"
SNAPSHOT="${STAGE}/vault/raft.snap"
ENC="${BACKUP_TMP}/${archive_name}"
mkdir -p "${STAGE}/vault" "${STAGE}/config" "${STAGE}/policies"

# 1) Consistent Raft snapshot, taken with the snapshot-only backup token.
info "Taking a consistent Vault Raft snapshot..."
LOCAL_VAULT_TOKEN="${LOCAL_VAULT_TOKEN}" vault_local operator raft snapshot save "${SNAPSHOT}" >/dev/null \
  || fail "Failed to take a Vault Raft snapshot."
[ -s "${SNAPSHOT}" ] || fail "Raft snapshot is empty."
# Inspect verifies the snapshot is well-formed before we package it.
LOCAL_VAULT_TOKEN="${LOCAL_VAULT_TOKEN}" vault_local operator raft snapshot inspect "${SNAPSHOT}" >/dev/null 2>&1 \
  || warn "Snapshot inspect reported an issue (continuing; older vault CLIs lack this subcommand)."

# 2) Non-secret config + policies. NOTE: secrets.map is intentionally excluded
#    (it is non-secret, but the archive stays minimal per docs/BACKUP-RESTORE.md).
#    We NEVER copy the live Raft data dir, tokens, or the private age identity.
cp -p "${LOCALCLAW_VAULT_HCL}"     "${STAGE}/config/vault.hcl"
cp -p "${LOCALCLAW_STACK_CONF}"    "${STAGE}/config/stack.conf"
cp -p "${LOCALCLAW_OPENCLAW_JSON}" "${STAGE}/config/openclaw.json"
# Copy only the tracked *.hcl policy files.
for p in "${POLICY_DIR}"/*.hcl; do
  [ -e "${p}" ] || continue
  cp -p "${p}" "${STAGE}/policies/"
done

# 3) Manifest with checksums so a restore can verify integrity.
vault_ver="$("${VAULT_BIN}" version 2>/dev/null | head -1 || echo unknown)"
openclaw_ver="unknown"
if have "${OPENCLAW_BIN}"; then
  openclaw_ver="$("${OPENCLAW_BIN}" --version 2>/dev/null | head -1 || echo unknown)"
fi
{
  printf 'archive_schema=1\n'
  printf 'app=%s\n' "${APP_NAME}"
  printf 'created_utc=%s\n' "${timestamp}"
  printf 'weekly_period=%s\n' "${weekly_period}"
  printf 'vault_version=%s\n' "${vault_ver}"
  printf 'openclaw_version=%s\n' "${openclaw_ver}"
  printf 'snapshot_sha256=%s\n' "$(sha256_of "${SNAPSHOT}")"
  printf 'vault_hcl_sha256=%s\n' "$(sha256_of "${STAGE}/config/vault.hcl")"
} >"${STAGE}/MANIFEST.txt"

# Per-file checksums for everything staged (a SHA256SUMS file inside the archive).
( cd "${STAGE}" && find . -type f ! -name 'SHA256SUMS' | LC_ALL=C sort | while IFS= read -r rel; do
    printf '%s  %s\n' "$(sha256_of "${rel}")" "${rel}"
  done ) >"${STAGE}/SHA256SUMS"
chmod 600 "${STAGE}/MANIFEST.txt" "${STAGE}/SHA256SUMS" 2>/dev/null || true

# 4) Package + encrypt in a single stream: tar -> age. No plaintext tarball ever
#    lands on disk; the only artifact is the ciphertext.
info "Encrypting snapshot archive to the age recipient..."
if ! tar -C "${STAGE}" -czf - . | "${AGE_BIN}" --encrypt -R "${LOCALCLAW_AGE_RECIPIENT_FILE}" --output "${ENC}"; then
  fail "Failed to package/encrypt the backup archive."
fi
[ -s "${ENC}" ] || fail "Encrypted backup is empty."

# 5) Optional local verification: confirm the ciphertext decrypts and lists.
if [ -n "${BACKUP_VERIFY_IDENTITY:-}" ]; then
  [ -r "${BACKUP_VERIFY_IDENTITY}" ] || fail "BACKUP_VERIFY_IDENTITY is unreadable: ${BACKUP_VERIFY_IDENTITY}"
  if ! "${AGE_BIN}" --decrypt --identity "${BACKUP_VERIFY_IDENTITY}" "${ENC}" | tar -tzf - >/dev/null 2>&1; then
    fail "Backup verification failed: the archive did not decrypt/list with the provided identity."
  fi
  ok "Verified the encrypted archive decrypts and lists with the local identity."
fi

# ---------------------------------------------------------------------------
# 6) Atomic writes into Daily/ and Weekly/. Write a dot-prefixed .partial in the
#    SAME directory, then rename into place -- a reader never sees a half file.
# ---------------------------------------------------------------------------
ensure_private_dir "${BACKUP_DIR}"
ensure_private_dir "${DAILY_DIR}"
ensure_private_dir "${WEEKLY_DIR}"

atomic_install() {
  # atomic_install <src> <dest-dir> <name>
  local src="$1" dir="$2" name="$3" tmp
  tmp="${dir}/.${name}.partial"
  rm -f "${tmp}"
  ( umask 077; cp "${src}" "${tmp}" )
  chmod 600 "${tmp}" 2>/dev/null || true
  mv -f "${tmp}" "${dir}/${name}" || fail "Failed to place archive: ${dir}/${name}"
}

atomic_install "${ENC}" "${DAILY_DIR}"  "${archive_name}"
# The weekly slot is refreshed by the same verified ciphertext, so a later
# same-week backup improves that week's recovery point without duplicating it.
atomic_install "${ENC}" "${WEEKLY_DIR}" "${weekly_name}"

# 7) Record today's success (atomic) for the once-per-day guard.
ensure_private_dir "$(dirname "${LOCALCLAW_LAST_BACKUP_FILE}")"
last_tmp="$(mktemp "${LOCALCLAW_CONFIG_DIR}/.vault-backup-last.XXXXXX")" \
  || fail "Unable to record last-backup marker."
printf '%s|%s\n' "${today}" "${archive_name}" >"${last_tmp}"
chmod 600 "${last_tmp}" 2>/dev/null || true
mv -f "${last_tmp}" "${LOCALCLAW_LAST_BACKUP_FILE}"

# 8) Retention: keep the newest N in each dir. prune_to_count only ever removes
#    files matching the encrypted-backup glob, newest-first, and never touches
#    unrelated files in the directory.
daily_removed="$(prune_to_count "${DAILY_DIR}" "${DAILY_GLOB}" "${BACKUP_KEEP_DAILY}")"
weekly_removed="$(prune_to_count "${WEEKLY_DIR}" "${WEEKLY_GLOB}" "${BACKUP_KEEP_WEEKLY}")"

ok "Encrypted daily backup written:   ${DAILY_DIR}/${archive_name}"
ok "Encrypted weekly backup refreshed: ${WEEKLY_DIR}/${weekly_name}"
if [ "${daily_removed}" -gt 0 ] || [ "${weekly_removed}" -gt 0 ]; then
  info "Retention removed ${daily_removed} daily and ${weekly_removed} weekly archive(s)."
fi
exit 0
